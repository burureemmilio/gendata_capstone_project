      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.05auf2v0w4y26u17ftrt50r97x0r].[avg:Core health workforce per 10,000&#13;population:qk]&quot;' value='Health Workers per 10,000 population' />
          <alias key='&quot;[federated.05auf2v0w4y26u17ftrt50r97x0r].[avg:Health Access Index:qk]&quot;' value='Health Access index' />
          <alias key='&quot;[federated.05auf2v0w4y26u17ftrt50r97x0r].[avg:Insurance percentage:qk]&quot;' value='Insurance Percentage' />
          <alias key='&quot;[federated.05auf2v0w4y26u17ftrt50r97x0r].[sum:County Population:qk]&quot;' value='Population' />
        </aliases>
      </column>
      <column caption='Health Workers Filter' datatype='string' name='[Calculation_0396127278473216]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Core health workforce per 10,000&#13;population] &gt;= 25 THEN &quot;High&quot;&#10;ELSEIF [Core health workforce per 10,000&#13;population] &gt;= 18 THEN &quot;Medium&quot;&#10;ELSEIF [Core health workforce per 10,000&#13;population] &gt;= 10 THEN &quot;Low&quot;&#10;ELSE &quot;Very Low&quot;&#10;END' />
      </column>
      <column caption='Facilities Filter' datatype='string' name='[Calculation_0396127279988737]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Facilities per 100,000 population] &gt;=  30 THEN &quot;High&quot;&#10;ELSEIF [Facilities per 100,000 population] &gt;= 25 THEN &quot;Moderate&quot;&#10;ELSEIF [Facilities per 100,000 population] &gt;= 20 THEN &quot;Low&quot;&#10;ELSE &quot;Very Low&quot;&#10;END' />
      </column>
      <column caption='Insurance Filter' datatype='string' name='[Calculation_0396127281340418]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Insurance percentage] &gt;= 0.3 THEN &quot;High&quot;&#10;ELSEIF [Insurance percentage] &gt;= 0.2 THEN &quot;Medium&quot;&#10;ELSEIF [Insurance percentage] &gt;= 0.15 THEN &quot;Low&quot;&#10;ELSE &quot;Very Low&quot;&#10;END' />
      </column>
      <column caption='Ranking' datatype='integer' name='[Calculation_0396127283707907]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM([Facilities per 100,000 population]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank2' datatype='string' name='[Calculation_0396127285571589]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK_UNIQUE(SUM([Facilities per 100,000 population]), &apos;desc&apos;) &lt;= 10&#10;OR&#10;RANK_UNIQUE(SUM([Facilities per 100,000 population]), &apos;asc&apos;) &lt;= 10&#10;THEN &apos;Keep&apos;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Access Category' datatype='string' name='[Calculation_5428109761990656]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Health Access Index] &gt;= 70 THEN &quot;High Access&quot;&#10;ELSEIF [Health Access Index] &gt;= 50 THEN &quot;Moderate Access&quot;&#10;ELSEIF [Health Access Index] &gt;= 30 THEN &quot;Low Access&quot;&#10;ELSE &quot;Very Low Access&quot;&#10;END' />
      </column>
      <column caption='Top Bottom Flag' datatype='string' name='[Calculation_5428109792878594]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF INDEX() &lt;= [Parameters].[Parameter 5428109786173441]&#10;OR INDEX() &gt;= SIZE() - [Parameters].[Parameter 5428109786173441]&#10;THEN &quot;Show&quot;&#10;ELSE &quot;Hide&quot;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Radar Facilities' datatype='real' name='[Calculation_6170211774853121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [County] = [Parameters].[Parameter 6170211774464000]&#10;THEN [Facilities per 100,000 population]&#10;END' />
      </column>
      <column caption='Radar Workforce' datatype='real' name='[Calculation_6170211775295490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [County] = [Parameters].[Parameter 6170211774464000]&#10;THEN [Core health workforce per 10,000&#13;population]&#10;END' />
      </column>
      <column caption='Priority Category' datatype='string' name='[Calculation_6170211790622728]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Health Access Index] &gt;= 70 THEN &quot;Low Priority&quot;&#10;ELSEIF [Health Access Index] &gt;= 50 THEN &quot;Moderate Priority&quot;&#10;ELSEIF [Health Access Index] &gt;= 30 THEN &quot;High Priority&quot;&#10;ELSE &quot;Critical Priority&quot;&#10;END' />
      </column>
      <column caption='Recommendations' datatype='string' name='[Calculation_6170211794690057]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Financial Access Score] &lt; 50 THEN&#10;&#10;&quot;Increase health facilities&quot;&#10;&#10;ELSEIF [Infrastructure Score] &lt; 50 THEN&#10;&#10;&quot;Improve insurance coverage&quot;&#10;&#10;ELSEIF [Readiness Score] &lt; 50 THEN&#10;&#10;&quot;Improve facility readiness&quot;&#10;&#10;ELSE&#10;&#10;&quot;Maintain current investment&quot;&#10;&#10;END' />
      </column>
